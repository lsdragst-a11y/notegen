*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Data & model artifacts
data/raw/*
data/audio/*
data/outputs/*
# B 站 DPAPI 解出来的 cookie，私有 + 易过期，本地缓存不入库
data/.cookies/
!data/raw/.gitkeep
!data/audio/.gitkeep
!data/outputs/.gitkeep
# 评估聚合结果（论文用，必须入库）
!data/outputs/eval_*.json
!data/outputs/headline_rating_*.json
# 跑批验证 scratch（dryrun / 新旧对照 / 特征缓存），不入库
data/_dryrun_*
data/_compare_*
models/
models_msc_cache/
wheels/
*.pt
*.bin
*.safetensors
*.ckpt

# Frontend
web/node_modules/
web/.next/
web/out/
