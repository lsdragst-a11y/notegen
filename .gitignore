# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Data & model artifacts
data/raw/*
data/audio/*
data/outputs/*
# B 站 DPAPI 解出来的 cookie，私有 + 易过期，本地缓存不入库
data/.cookies/
!data/raw/.gitkeep
!data/audio/.gitkeep
!data/outputs/.gitkeep
# 评估聚合结果（论文用，必须入库）
!data/outputs/eval_*.json
!data/outputs/headline_rating_*.json
# 跑批验证 scratch（dryrun / 新旧对照 / 特征缓存），不入库
data/_dryrun_*
data/_compare_*
# 运行期 SQLite 库（账号/会话/笔记归属/历史），含密码哈希与用户数据，不入库
data/notegen.db
data/notegen.db-wal
data/notegen.db-shm
data/redis/
# DB 备份（e2e/迁移留存），同样含 bcrypt 哈希，严禁入库
data/*.e2ebak
data/user_notes/
backups/*.zip
.playwright-cli/
models/
models_msc_cache/
wheels/
*.pt
*.bin
*.safetensors
*.ckpt

# Frontend
web/node_modules/
web/.next/
web/out/
web/output/
# 前端 demo 视频 612MB，本地资源不入库
web/public/videos/

# Notebooks
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Logs
logs/
*.log
wandb/
runs/

# Local Codex/visual QA artifacts
.codex-run/
